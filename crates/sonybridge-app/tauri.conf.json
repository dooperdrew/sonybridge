{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XMCompanion",
  "version": "0.3.0",
  "identifier": "com.xmcompanion.app",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "windows": [
      {
        "title": "XMCompanion — Sony WH-1000XM Desktop Companion",
        "width": 860,
        "height": 780,
        "minWidth": 640,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "center": true,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
